# Django core. Use a long random SECRET_KEY in Render; never commit a real production value.
SECRET_KEY=change-me-to-a-secure-random-value
# Local development must be True. Render should be False (the settings default).
DEBUG=True
# Comma-separated hosts. After the first Render deploy, add the service domain
# shown in the dashboard, for example: localhost,127.0.0.1,jenga.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app

# Local PostgreSQL. Used only when DATABASE_URL is not set, so local .env keeps working.
DB_NAME=jenga
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Render attaches Postgres and injects DATABASE_URL automatically. Leave unset locally.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/NAME

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False
# Optional. Render's hostname is added automatically; set this if forms need extra HTTPS origins.
# CSRF_TRUSTED_ORIGINS=https://jenga.onrender.com

# Assistant LLM (Gemini). Required on Render if the AI assistant should answer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Sunbird translation used by the assistant.
SUNBIRD_API_TOKEN=

# Africa's Talking SMS gateway.
AT_USERNAME=sandbox
AT_API_KEY=
